# Public addresses. Do not add a trailing slash.
FEED_BASE_URL=https://rss.example.com

# Omni source pages. Comma-separated; /senaste covers all categories, while / adds top stories.
OMNI_SOURCE_URLS=https://omni.se/senaste,https://omni.se/
OMNI_MAX_CANDIDATES_PER_SOURCE=50
OMNI_MAX_FEED_ITEMS=100
OMNI_RETENTION_DAYS=30
OMNI_MIN_ITEMS=1
OMNI_REQUEST_TIMEOUT_SECONDS=20
OMNI_REQUEST_DELAY_SECONDS=0.6
OMNI_USER_AGENT="omni-rss/1.0 (+mailto:you@example.com)"

# R2 S3 API credentials. Keep this file mode 0600.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=omni-rss
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# Leave blank to publish as /rss.xml and /atom.xml.
R2_PREFIX=

# Optional: node_exporter textfile collector directory.
# PROMETHEUS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/omni_rss.prom
